PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Set DB_MODE to "demo" to connect to the demo database,
# "prod" to connect to the production database,
# or leave blank to fall back to MONGODB_URI.
DB_MODE=demo

# Production database
MONGODB_URI_PROD=mongodb://localhost:27017/wearable-monitoring

# Demo database (populated by: npm run seed:demo)
MONGODB_URI_DEMO=mongodb://localhost:27017/wearable-monitoring-demo

# Fallback (used when DB_MODE is not set and MONGODB_URI_PROD is absent)
MONGODB_URI=mongodb://localhost:27017/wearable-monitoring
# ─────────────────────────────────────────────────────────────────────────────

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
NODE_ENV=development
ALERT_TEMP_THRESHOLD=38
ALERT_UV_THRESHOLD=7
ALERT_HUMIDITY_THRESHOLD=70
# Comma-separated list of origins allowed by CORS (React dev server, etc.)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
# Secret required to create the first admin account via /api/auth/bootstrap-admin
# Remove or leave blank to disable the bootstrap endpoint
BOOTSTRAP_SECRET=change_this_to_a_strong_random_secret
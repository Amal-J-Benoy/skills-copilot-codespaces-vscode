# React App Environment Variables
# Copy this file to .env and fill in your values

# API base URL (defaults to http://localhost:5000/api)
REACT_APP_API_URL=http://localhost:5000/api

# Demo Mode: set to true to always start in demo mode (uses mock data, no real API calls)
REACT_APP_DEMO_MODE=false

# Demo Enabled: set to false to hide the demo toggle UI entirely
REACT_APP_DEMO_ENABLED=true
